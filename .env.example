SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_replace_me
SUPABASE_IMAGE_BUCKET=microscopy
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urolens_db
JWT_SIGNING_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
# Longest a staff session lasts (one shift). "Keep me signed in" tokens last this long;
# refreshing never goes past it.
JWT_EXPIRY_HOURS=8
# Lifetime of a normal access token, renewed with POST /auth/refresh while the user is active.
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_FAILED_ATTEMPTS=5
ENCRYPTION_KEY=generate-with-python-cryptography-fernet-Fernet.generate_key()
DEDUP_HASH_KEY=generate-with-python-secrets-token_hex(32)
AI_MODEL_VERSION=mvp-v1.0
# AI engine files. LEAVE THESE UNSET. Since engine v0.2.0 (the pin in
# requirements.txt) the install ships its own weights, rules and thresholds, and the
# backend finds them inside <site-packages>/urolens_ai/. At startup the server logs an
# "AI engine:" error when the engine is older than 0.2.0, when one of these variables
# points anywhere but the engine's own file (e.g. an old hand-copied weights.pt, which a
# reinstall does not remove), or when a file is missing. With FIELD_WORKFLOW_ENABLED on,
# any such error stops the server from starting.
# Upgrading a server from an older engine: remove these four variables, reinstall the
# engine at the pin, restart, and check the log has no "AI engine:" lines.
# MODEL_WEIGHTS_PATH=      (models/yolov8/best.pt; without it every upload fails)
# GATE_WEIGHTS_PATH=       (models/gate/gate.pt; without it every upload fails)
# RULE_ENGINE_CONFIG_PATH= (smart_diagnosis/config.yaml; without it no Smart Diagnosis)
# CLASS_THRESHOLDS_PATH=   (models/yolov8/thresholds.yaml; optional)
# Multi-field workflow. The flag is read once at startup; changing it needs a restart.
# Turning it on also makes the AI engine check above fatal at startup.
# FIELD_WORKFLOW_ENABLED=false
# MIN_FIELDS_PER_SPECIMEN=10
# FIELD_LOW_CONFIDENCE_THRESHOLD=0.5
# FIELD_OUTLIER_MULTIPLIER=2.0
# FIELD_OUTLIER_MIN_ABOVE=5
