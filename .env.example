SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_replace_me
SUPABASE_IMAGE_BUCKET=microscopy
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urolens_db
JWT_SIGNING_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
# Longest a staff session lasts (one shift). "Keep me signed in" tokens last this long;
# refreshing never goes past it.
JWT_EXPIRY_HOURS=8
# Lifetime of a normal access token, renewed with POST /auth/refresh while the user is active.
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_FAILED_ATTEMPTS=5
ENCRYPTION_KEY=generate-with-python-cryptography-fernet-Fernet.generate_key()
DEDUP_HASH_KEY=generate-with-python-secrets-token_hex(32)
AI_MODEL_VERSION=mvp-v1.0
MODEL_VERSION=mvp-v1.0
# YOLOv8 weights for the AI engine. Required in production: the urolens_ai package
# doesn't ship them, and without weights every image upload fails (AI_ANALYSIS_FAILED).
# May be omitted if the file is at <site-packages>/urolens_ai/models/yolov8/best.pt.
# For sibling checkouts, use ../urolens-ai-engine/src/urolens_ai/models/yolov8/best.pt.
# MODEL_WEIGHTS_PATH=/absolute/path/to/best.pt
# Input-gate (slide / not-slide) classifier weights, only needed once the installed
# urolens_ai package includes the input gate. Same deal as MODEL_WEIGHTS_PATH: required
# in production, or every upload fails (503 MODEL_NOT_LOADED). May be omitted if the
# file is at <site-packages>/urolens_ai/models/gate/gate.pt.
# GATE_WEIGHTS_PATH=/absolute/path/to/gate.pt
INFERENCE_CONF_THRESHOLD=0.35
INFERENCE_IOU_THRESHOLD=0.5
GATE_MIN_SLIDE_PROB=0.43
