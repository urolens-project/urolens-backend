SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_replace_me
SUPABASE_IMAGE_BUCKET=microscopy
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urolens_db
JWT_SIGNING_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
# Longest a staff session lasts (one shift). "Keep me signed in" tokens last this long;
# refreshing never goes past it.
JWT_EXPIRY_HOURS=8
# Lifetime of a normal access token, renewed with POST /auth/refresh while the user is active.
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_FAILED_ATTEMPTS=5
ENCRYPTION_KEY=generate-with-python-cryptography-fernet-Fernet.generate_key()
DEDUP_HASH_KEY=generate-with-python-secrets-token_hex(32)
AI_MODEL_VERSION=mvp-v1.0
# AI engine files. The urolens_ai install ships no data files, so set these in
# production; the server logs an "AI engine:" error at startup for each one missing.
# Each may be omitted if the file is inside <site-packages>/urolens_ai/ at the path shown.
# Detector weights (models/yolov8/best.pt). Without them every upload fails (AI_ANALYSIS_FAILED).
# MODEL_WEIGHTS_PATH=/absolute/path/to/best.pt
# Input-gate classifier (models/gate/gate.pt). Without it every upload fails (AI_ANALYSIS_FAILED).
# GATE_WEIGHTS_PATH=/absolute/path/to/gate.pt
# Smart Diagnosis rules (smart_diagnosis/config.yaml). Without it no Smart Diagnosis is produced.
# RULE_ENGINE_CONFIG_PATH=/absolute/path/to/config.yaml
# Optional per-class confidence thresholds (models/yolov8/thresholds.yaml).
# CLASS_THRESHOLDS_PATH=/absolute/path/to/thresholds.yaml
# Multi-field workflow. The flag is read once at startup; changing it needs a restart.
# FIELD_WORKFLOW_ENABLED=false
# MIN_FIELDS_PER_SPECIMEN=10
# FIELD_LOW_CONFIDENCE_THRESHOLD=0.5
# FIELD_OUTLIER_MULTIPLIER=2.0
# FIELD_OUTLIER_MIN_ABOVE=5
