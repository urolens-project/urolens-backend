# Non-secret app settings pushed to Azure by set-config.ps1.
# Safe to commit: NO secrets here. Secrets live in deploy/secrets.local.env or are prompted.
# Format: KEY=VALUE, one per line. Lines starting with # are ignored.

# Port the container listens on (the Dockerfile runs uvicorn on 8000). Azure needs to be told.
WEBSITES_PORT=8000

# How long Azure waits for the container to start before giving up (seconds).
# The AI model loads at startup, so give it plenty of time.
WEBSITES_CONTAINER_START_TIME_LIMIT=600

# CPU threads PyTorch may use. B1 has 1 vCPU, so keep this at 1.
TORCH_NUM_THREADS=1

# Multi-field workflow master switch.
FIELD_WORKFLOW_ENABLED=false

# Comma-separated list of browser origins allowed to call the API. Empty for now.
CORS_ALLOWED_ORIGINS=

# Supabase project URL (not secret). REQUIRED: fill in before running set-config.ps1.
# Example shape: https://<project-ref>.supabase.co
SUPABASE_URL=https://rrwmrlzqlsqqpkhpxxot.supabase.co

# Supabase Storage bucket for microscopy images (app default is "microscopy").
SUPABASE_IMAGE_BUCKET=microscopy
