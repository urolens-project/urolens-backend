# Placeholder values only. Copy to .env.docker (git-ignored by .env.*) and fill in real
# secrets at deploy time via your platform's secret store; never bake them into the image.

# ── Database ──────────────────────────────────────────────────────────
# Sync URL; the app derives the asyncpg URL from it. Scratch DB from a container:
# host.docker.internal:5433
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5433/deploy_test

# ── Auth / JWT ────────────────────────────────────────────────────────
JWT_SIGNING_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_FAILED_ATTEMPTS=5

# ── Encryption ────────────────────────────────────────────────────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-fernet-key
# python -c "import secrets; print(secrets.token_hex(32))"
DEDUP_HASH_KEY=replace-with-a-random-hex-string

# ── Supabase storage ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=replace-me
SUPABASE_IMAGE_BUCKET=microscopy

# ── Push notifications (mobile) ───────────────────────────────────────
# None. Expo push tokens are stored per user (POST /users/push-token); the backend
# has no push credentials in its config.

# ── AI / rules config ─────────────────────────────────────────────────
AI_MODEL_VERSION=mvp-v1.0
# MODEL_WEIGHTS_PATH, GATE_WEIGHTS_PATH, RULE_ENGINE_CONFIG_PATH, CLASS_THRESHOLDS_PATH:
# leave unset; the engine's bundled files are used.
FIELD_WORKFLOW_ENABLED=false
MIN_FIELDS_PER_SPECIMEN=10
FIELD_LOW_CONFIDENCE_THRESHOLD=0.5
FIELD_OUTLIER_MULTIPLIER=2.0
FIELD_OUTLIER_MIN_ABOVE=5

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API (the web app), e.g.
# https://app.example.com,https://admin.example.com
# Empty (default) allows none. The mobile app sends no Origin and is unaffected.
CORS_ALLOWED_ORIGINS=

# ── CPU threads ───────────────────────────────────────────────────────
# Torch intra-op threads (default 1; OMP/MKL are pinned to 1 in the Dockerfile).
# Raise only with more than one vCPU.
TORCH_NUM_THREADS=1
